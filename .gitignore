# Virtual environments (.venv is a symlink to a venv stored outside the
# repo/iCloud; a trailing slash would not match a symlink)
.venv
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.coverage
htmlcov/

# Raw data: immutable downloads, regenerated by pipeline.
# Each raw dataset dir's full contents are ignored; .gitkeep markers and the
# provenance manifest ARE committed.
data/raw/mtbs_perimeter/**
data/raw/census_counties/**
data/raw/silvis_wui/**
data/raw/nature_wui/**
data/raw/census_places/**
!data/raw/mtbs_perimeter/.gitkeep
!data/raw/census_counties/.gitkeep
!data/raw/silvis_wui/.gitkeep
!data/raw/nature_wui/.gitkeep
!data/raw/census_places/.gitkeep
data/raw/*.zip
!data/raw/provenance.json

# Derived spatial data: large generated files, never committed
data/interim/**
!data/interim/.gitkeep
data/processed/**
!data/processed/.gitkeep

# Pipeline logs (timestamped, not reviewable)
outputs/logs/**
!outputs/logs/.gitkeep

# Secrets / credentials — never commit
.env
.env.*
*.pem
*.key
*credentials*
*secret*
secrets/

# Optional per-clone data-root override (may expand $HOME; never commit)
.data_root

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp